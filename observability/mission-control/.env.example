# Copy to .env (git-ignored) to override the defaults. Compose reads it for variable substitution.
# Never commit a key. Simulation needs both lines below and only works with MC_ENV=local.
# MC_SIMULATION=1
# MC_SANDBOX_KEY=            # a dt_sk_test_ sandbox key from `dtctl`; never a live key
MC_ENV=local
MC_METRICS_SOURCE=builtin    # builtin | prometheus | cloudwatch
# MC_PROMETHEUS_URL=
# Deep-link templates, e.g. MC_LINK_GRAFANA=http://localhost:3000/explore?traceId={trace_id}

        "textMode": "auto"
      }
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Pending alerts",
      "description": "Alerts over their threshold but not yet past their for: time.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 20,
        "y": 7,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(ALERTS{alertstate=\"pending\"}) or vector(0)",

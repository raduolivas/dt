    {
      "id": 43,
      "type": "timeseries",
      "title": "Courier token refresh by outcome",
      "description": "ok, reuse, expired, invalid.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 28,
        "w": 8,

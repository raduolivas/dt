        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Courier sessions started by mode",
      "description": "Courier sessions started, by mode (sdk, link). A counter: shows starts per interval.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode) (increase(dt_courier_sessions_started_total[$__rate_interval]))",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none",
